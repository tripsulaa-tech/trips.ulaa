VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Server-only (Vercel Serverless Functions under /api) — never prefix these
# with VITE_, or they would be bundled into the public client JS.
# Used by api/invoices/[id]/pdf.ts (production) and, for local invoice-PDF
# testing under `npm run dev`, by vite-plugins/invoicePdfDevMiddleware.ts —
# both fetch booking + payment data with Supabase's service-role key
# (bypasses RLS; each route does its own Authorization: Bearer <token>
# check instead) and render the invoice PDF. Without these set locally,
# "Download Invoice" in the admin panel will fail in dev.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional, local dev only. vite-plugins/invoicePdfDevMiddleware.ts renders
# invoice PDFs with your machine's installed Chrome or Edge (no download).
# It auto-detects Chrome, then falls back to Edge's usual install path; set
# this only if it can't find either (point it at your browser's .exe path).
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Microsoft\Edge\Application\msedge.exe
