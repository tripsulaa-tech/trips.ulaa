VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Server-only (Vercel Serverless Functions under /api) — never prefix these
# with VITE_, or they would be bundled into the public client JS.
# Used by api/invoices/[id]/pdf.ts to fetch booking + payment data with
# Supabase's service-role key (bypasses RLS; the route does its own
# Authorization: Bearer <token> check instead) and render the invoice PDF.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
